# Register a domain-restricted browser/server token at https://www.tianditu.gov.cn/
# Never commit the real token.
TIANDITU_TOKEN=

# This account has no services/mars entitlement. Use the global Open Data
# message cache; the forecast collector retrieves each model cycle once.
ECMWF_FORECAST_BACKEND=open-data
ECMWF_WEATHER_MAP_BACKEND=open-data

# Production service settings are intentionally kept non-secret here.
METEOSTATION_DOMAIN=meteostation.top
