[Unit]
Description=CloudyLake global three-day sounding backfill collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meteostation
Group=meteostation
WorkingDirectory=/opt/meteostation
EnvironmentFile=-/opt/meteostation/.env
ExecStart=/opt/meteostation/.venv/bin/python run_global_sounding_collector.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
